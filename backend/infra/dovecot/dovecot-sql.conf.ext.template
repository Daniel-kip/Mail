# SQL lookups against the platform's read-only views (role: mv_mailserver).
# Only mailboxes that are active, on a verified hosting-enabled domain of an
# active tenant appear in mail_mailboxes, so disabling any of those blocks
# IMAP/SMTP access immediately.
driver = pgsql
connect = host=${DB_HOST} dbname=${DB_NAME} user=${DB_USER} password=${DB_PASSWORD}

# Stored hashes carry their scheme prefix ({ARGON2ID}$argon2id$...).
default_pass_scheme = ARGON2ID

password_query = SELECT address AS user, password FROM mail_mailboxes WHERE address = lower('%u')

user_query = SELECT '/var/vmail/' || storage_key AS home, \
  5000 AS uid, 5000 AS gid, \
  '*:bytes=' || quota_bytes AS quota_rule \
  FROM mail_mailboxes WHERE address = lower('%u')

iterate_query = SELECT address AS user FROM mail_mailboxes
