# Postfix main.cf — rendered at container start by entrypoint.sh (envsubst).
# Reviewed, version-controlled configuration (guide 06). Secrets come from
# the environment, never from this file.

compatibility_level = 3.6
myhostname = ${MAIL_HOSTNAME}
myorigin = $myhostname
mydestination = localhost
inet_interfaces = all
inet_protocols = ipv4
# Only loopback is trusted. The platform API authenticates like any client.
mynetworks = 127.0.0.0/8
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
disable_vrfy_command = yes
strict_rfc821_envelopes = yes
message_size_limit = 26214400
mailbox_size_limit = 0
recipient_delimiter = +

# ── TLS ──────────────────────────────────────────────────────────────────
smtpd_tls_cert_file = /etc/ssl/mail/fullchain.pem
smtpd_tls_key_file = /etc/ssl/mail/privkey.pem
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_loglevel = 1
smtpd_tls_received_header = yes
smtp_tls_security_level = may
smtp_tls_protocols = >=TLSv1.2
smtp_tls_loglevel = 1
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt

# ── hosted domains (live views in PostgreSQL) ────────────────────────────
virtual_mailbox_domains = pgsql:/etc/postfix/pgsql/virtual_domains.cf
virtual_mailbox_maps = pgsql:/etc/postfix/pgsql/virtual_mailboxes.cf
virtual_alias_maps = pgsql:/etc/postfix/pgsql/virtual_aliases.cf
virtual_transport = lmtp:inet:${DOVECOT_HOST}:24
smtpd_sender_login_maps = pgsql:/etc/postfix/pgsql/sender_logins.cf

# Return-path domain: DSNs addressed to b+<id>-<tag>@ are piped to the API.
relay_domains = ${RETURN_PATH_DOMAIN}
relay_recipient_maps =
transport_maps = inline:{ ${RETURN_PATH_DOMAIN}=bounce-api: }
bounce-api_destination_recipient_limit = 1

# ── SASL (Dovecot over the private network) ──────────────────────────────
smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:${DOVECOT_HOST}:12345
smtpd_sasl_auth_enable = no
smtpd_sasl_security_options = noanonymous
broken_sasl_auth_clients = no
# Used by the private platform relay service (master.cf port 10587).
platform_relay_restrictions = check_sasl_access inline:{ ${RELAY_USER}=OK }, reject

# ── restrictions: no open relay, reject unknown recipients during SMTP ───
smtpd_helo_required = yes
smtpd_helo_restrictions = permit_mynetworks, reject_invalid_helo_hostname, reject_non_fqdn_helo_hostname
smtpd_sender_restrictions = reject_non_fqdn_sender, reject_unknown_sender_domain
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
smtpd_recipient_restrictions =
    reject_non_fqdn_recipient,
    reject_unknown_recipient_domain,
    reject_unlisted_recipient,
    check_policy_service inet:${DOVECOT_HOST}:10993,
    permit
smtpd_data_restrictions = reject_unauth_pipelining
smtpd_client_connection_rate_limit = 60
smtpd_client_message_rate_limit = 200
anvil_rate_time_unit = 60s
smtpd_error_sleep_time = 2s
smtpd_soft_error_limit = 5
smtpd_hard_error_limit = 10

# ── content filtering (Rspamd milter) ────────────────────────────────────
smtpd_milters = inet:${RSPAMD_HOST}:11332
non_smtpd_milters = $smtpd_milters
milter_protocol = 6
milter_default_action = accept
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}

# ── queue behaviour ──────────────────────────────────────────────────────
delay_warning_time = 4h
maximal_queue_lifetime = 3d
bounce_queue_lifetime = 2d
minimal_backoff_time = 300s
maximal_backoff_time = 3600s
smtp_destination_concurrency_limit = 10

maillog_file = /dev/stdout
