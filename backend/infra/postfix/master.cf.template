# Postfix master.cf — rendered at container start (envsubst).
# service type  private unpriv  chroot  wakeup  maxproc command + args

# Public MX (port 25): inbound mail for hosted domains and DSNs. No AUTH.
smtp      inet  n       -       n       -       -       smtpd
  -o smtpd_sasl_auth_enable=no

# Authenticated submission for mail clients (587 STARTTLS, 465 implicit TLS).
# Mailbox users may only send as their own address or aliases that deliver
# to them (reject_sender_login_mismatch + mail_sender_logins view).
submission inet n       -       n       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_tls_auth_only=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_sender_restrictions=reject_sender_login_mismatch,reject_non_fqdn_sender
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING
submissions inet n      -       n       -       -       smtpd
  -o syslog_name=postfix/submissions
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_sender_restrictions=reject_sender_login_mismatch,reject_non_fqdn_sender
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING

# Platform relay for the API workers. Private network only — never publish.
# Only the dedicated relay identity is accepted; it may use the VERP
# return-path sender because the API has already authorized the From domain.
10587     inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/platform
  -o smtpd_tls_security_level=may
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_tls_auth_only=no
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_sender_restrictions=
  -o smtpd_relay_restrictions=$platform_relay_restrictions
  -o smtpd_recipient_restrictions=$platform_relay_restrictions
  -o milter_macro_daemon_name=ORIGINATING

# Auto-replies generated by Dovecot Sieve (out-of-office). Private network
# only — never publish. Accepts only clients inside INTERNAL_NETWORK.
10026     inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/autoreply
  -o mynetworks=${INTERNAL_NETWORK}
  -o smtpd_sasl_auth_enable=no
  -o smtpd_client_restrictions=permit_mynetworks,reject
  -o smtpd_relay_restrictions=permit_mynetworks,reject
  -o smtpd_recipient_restrictions=permit_mynetworks,reject
  -o milter_macro_daemon_name=ORIGINATING

pickup    unix  n       -       n       60      1       pickup
cleanup   unix  n       -       n       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       n       1000?   1       tlsmgr
rewrite   unix  -       -       n       -       -       trivial-rewrite
bounce    unix  -       -       n       -       0       bounce
defer     unix  -       -       n       -       0       bounce
trace     unix  -       -       n       -       0       bounce
verify    unix  -       -       n       -       1       verify
flush     unix  n       -       n       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       n       -       -       smtp
relay     unix  -       -       n       -       -       smtp
showq     unix  n       -       n       -       -       showq
error     unix  -       -       n       -       -       error
retry     unix  -       -       n       -       -       error
discard   unix  -       -       n       -       -       discard
lmtp      unix  -       -       n       -       -       lmtp
anvil     unix  -       -       n       -       1       anvil
scache    unix  -       -       n       -       1       scache
postlog   unix-dgram n  -       n       -       1       postlogd

# DSNs and feedback reports → platform API (see bounce-to-api.sh).
bounce-api unix -       n       n       -       10      pipe
  flags=Rq user=nobody argv=/usr/local/bin/bounce-to-api.sh ${recipient}
