# Local development and testing (start-local.cmd creates .env from this file
# and fills DATA_ENCRYPTION_KEY automatically).
#
# Dependencies come from infra/docker-compose.dev.yml (Postgres, Mailpit,
# Dovecot). Every value here is a development-only default.
APP_ENV=development
HTTP_BIND=127.0.0.1:8088
# Console and webmail address (the PHP frontend): used in emailed links,
# activation/reset links, unsubscribe pages and phone setup.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Runtime role (DML only) and owner role for migrations.
DATABASE_URL=postgres://mv_app:mv_app_dev@127.0.0.1:5434/mailvora
MIGRATION_DATABASE_URL=postgres://mailvora:mailvora_dev@127.0.0.1:5434/mailvora

# 32 random bytes, base64. Generate with `mailvora gen-key`.
DATA_ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF_gen-key
INTERNAL_API_TOKEN=dev-internal-token-change-me-0123456789

# Mailpit SMTP sink (http://localhost:8025). Nothing leaves this machine.
SMTP_RELAY_HOST=127.0.0.1
SMTP_RELAY_PORT=1025
SMTP_RELAY_TLS=none

PLATFORM_DOMAIN=mailvora.localhost
SYSTEM_FROM_ADDRESS=no-reply@mailvora.localhost

# Without a real domain you cannot publish DNS records. This development-only
# switch makes verification checks pass; production refuses to start with it.
DEV_SKIP_DNS_VERIFICATION=true

# Hosted mailboxes / webmail: the Dovecot container from the dev compose file.
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_MASTER_USER=webmail
IMAP_MASTER_PASSWORD=dev-master-password-change-me-123
DOVEADM_API_URL=http://127.0.0.1:18080
DOVEADM_API_KEY=dev-doveadm-key-0123456789

# Public settings shown to staff configuring a separate email app (RFC 8314:
# implicit TLS first). For the optional local mailtier profile these map to
# host ports 1993 (IMAPS), 2465 (submissions) and 2587 (submission+STARTTLS).
# The development Dovecot certificate is self-signed, so real phones correctly
# refuse it; production must use a publicly trusted certificate and ports
# 993/465/587. Admins can override these per platform or domain in the
# operator console (Mail app settings).
EMAIL_CLIENT_IMAP_HOST=mail.mailvora.localhost
EMAIL_CLIENT_IMAP_PORT=1993
EMAIL_CLIENT_IMAP_TLS=tls
EMAIL_CLIENT_SMTP_HOST=mail.mailvora.localhost
EMAIL_CLIENT_SMTP_PORT=2465
EMAIL_CLIENT_SMTP_TLS=tls
EMAIL_CLIENT_SMTP_ALT_PORT=2587
EMAIL_CLIENT_SMTP_ALT_TLS=starttls
AUTOCONFIG_HOST=autoconfig.mailvora.localhost

# Out-of-office replies: ManageSieve on the dev Dovecot container.
MANAGESIEVE_HOST=127.0.0.1
MANAGESIEVE_PORT=4190

PRODUCT_NAME=Mailvora

# Kenyan-shilling billing: flat plan prices are charged exactly (set the VAT
# rate if you are VAT-registered and your prices exclude VAT).
BILLING_CURRENCY=KES
BILLING_TAX_RATE_BPS=0
BILLING_TAX_LABEL=VAT
BILLING_DUE_DAYS=14
BILLING_GRACE_DAYS=14
BILLING_ISSUER=Mailvora
BILLING_PAYMENT_INSTRUCTIONS=Pay with M-Pesa from the invoice page: enter your Safaricom number and approve the prompt on your phone.

# M-Pesa through PesaTide (https://pesatide.com). Leave empty to disable the
# "Pay with M-Pesa" button. Point the PesaTide webhook for this API key at
# {PUBLIC_API_URL}/v1/payments/pesatide/webhook.
PESATIDE_API_URL=https://pesatide.com/v1
PESATIDE_API_KEY=
PESATIDE_API_SECRET=
PESATIDE_WEBHOOK_SECRET=
PESATIDE_ROUTE_ID=

# SMS verification codes through Africa's Talking. Without credentials,
# development delivers codes to Mailpit; production disables phone checks.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# "Continue with Google" (OAuth client of type Web application; authorized
# redirect URI: {PUBLIC_BASE_URL}/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Refuse passwords found in public breaches (Pwned Passwords, k-anonymity).
PASSWORD_BREACH_CHECK=true

RUST_LOG=mailvora=info,tower_http=info
