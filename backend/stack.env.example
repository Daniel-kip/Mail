# Mailvora production configuration. Copy to stack.env and fill in every REQUIRED value.
# Generate secrets with:  openssl rand -base64 33   (or `mailvora gen-key`)
# Keep stack.env private (chmod 600); it holds every secret of the platform.

# ── environment ───────────────────────────────────────────────────────────
APP_ENV=production                         # development | production
PUBLIC_BASE_URL=https://app.example.com    # REQUIRED: the PHP web app (site, console, webmail); used in every emailed link
PUBLIC_API_URL=https://api.example.com     # REQUIRED: API address shown to developers
COOKIE_SECURE=true
ALLOW_SIGNUP=true                          # set false to allow only invited users
LOG_FORMAT=json
RUST_LOG=mailvora=info,tower_http=info

# ── secrets (REQUIRED) ────────────────────────────────────────────────────
DATA_ENCRYPTION_KEY=                       # 32 random bytes, base64 (`mailvora gen-key`). Back it up: losing it loses DKIM keys and webhook secrets.
INTERNAL_API_TOKEN=                        # >= 32 chars, shared with Postfix for bounce ingestion
POSTGRES_PASSWORD=                         # database owner (migrations)
MV_APP_PASSWORD=                           # runtime role (API + workers)
MV_MAILSERVER_PASSWORD=                    # read-only role for Postfix/Dovecot
RELAY_PASSWORD=                            # API → Postfix authenticated relay
IMAP_MASTER_PASSWORD=                      # API → Dovecot master user for webmail (>= 24 chars)
DOVEADM_API_KEY=                           # API → Dovecot doveadm HTTP API (immediate access revocation)
RSPAMD_CONTROLLER_PASSWORD=

# ── mail identity (REQUIRED) ──────────────────────────────────────────────
PLATFORM_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com             # A/PTR record of the mail host; MX target for hosted domains
SPF_INCLUDE=_spf.example.com               # publish this TXT: "v=spf1 ip4:<sending-ip> -all"
RETURN_PATH_DOMAIN=bounces.example.com     # MX → MAIL_HOSTNAME, SPF covering the sending IP
MESSAGE_ID_DOMAIN=example.com
SYSTEM_FROM_ADDRESS=no-reply@example.com   # verification/reset/invite mail; register this domain as a tenant domain to DKIM-sign it
SYSTEM_FROM_NAME=Mailvora
DKIM_SELECTOR_PREFIX=mv

RELAY_USER=relay@platform.internal
IMAP_MASTER_USER=webmail

# ── limits ────────────────────────────────────────────────────────────────
MAX_MESSAGE_BYTES=10485760
MAX_ATTACHMENT_BYTES=8388608
CONTENT_RETENTION_DAYS=30
SESSION_TTL_HOURS=12
WORKER_CONCURRENCY=8
DATABASE_MAX_CONNECTIONS=20
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# ── mail app settings shown to employees (RFC 8314: implicit TLS first) ────
# Hosts must present publicly trusted certificates. Operators can override
# these later in the operator console (Mail app settings), per domain too.
EMAIL_CLIENT_IMAP_HOST=mail.example.com
EMAIL_CLIENT_IMAP_PORT=993
EMAIL_CLIENT_IMAP_TLS=tls
EMAIL_CLIENT_SMTP_HOST=mail.example.com
EMAIL_CLIENT_SMTP_PORT=465
EMAIL_CLIENT_SMTP_TLS=tls
EMAIL_CLIENT_SMTP_ALT_PORT=587
EMAIL_CLIENT_SMTP_ALT_TLS=starttls
AUTOCONFIG_HOST=autoconfig.example.com     # Thunderbird autoconfig + Outlook Autodiscover are served by the API

# ── branding, web app and billing ─────────────────────────────────────────
PRODUCT_NAME=Mailvora
SUPPORT_EMAIL=support@example.com
COMPANY_NAME=Mailvora Ltd
COMPANY_ADDRESS=Nairobi, Kenya
APP_TIMEZONE=Africa/Nairobi
SIGNUP_ENABLED=true
BILLING_CURRENCY=KES                       # ISO 4217; M-Pesa payments require KES
BILLING_TAX_RATE_BPS=0                     # 1600 = 16% VAT added on top; 0 = prices charged as listed
BILLING_TAX_LABEL=VAT
BILLING_DUE_DAYS=14
BILLING_GRACE_DAYS=14
BILLING_ISSUER=Mailvora Ltd, PIN P000000000X
BILLING_PAYMENT_INSTRUCTIONS=Pay with M-Pesa from the invoice page, or by bank transfer quoting the invoice number.

# Optional: sign Apple .mobileconfig profiles (paths inside the frontend container).
APPLE_PROFILE_SIGNING_CERT=
APPLE_PROFILE_SIGNING_KEY=
APPLE_PROFILE_SIGNING_CHAIN=

# ── integrations ──────────────────────────────────────────────────────────
PESATIDE_API_URL=https://pesatide.com/v1
PESATIDE_API_KEY=                          # live key from the PesaTide dashboard
PESATIDE_API_SECRET=
PESATIDE_WEBHOOK_SECRET=                   # webhook URL: https://api.example.com/v1/payments/pesatide/webhook
PESATIDE_ROUTE_ID=                         # optional: your Paybill/Till channel id
AT_USERNAME=                               # Africa's Talking (SMS verification codes)
AT_API_KEY=
AT_SENDER_ID=
GOOGLE_CLIENT_ID=                          # redirect URI: https://app.example.com/auth/google/callback
GOOGLE_CLIENT_SECRET=
PASSWORD_BREACH_CHECK=true
