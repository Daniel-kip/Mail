# Mailvora web frontend (PHP). Copy to .env and adjust.
# In production set these as real environment variables (PHP-FPM pool or
# container env) and keep APP_ENV=production: the app refuses to start
# with insecure settings.

APP_ENV=development
APP_DEBUG=true
# Public address of this PHP site (used in QR codes, handouts and links).
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Africa/Nairobi

# Private address PHP uses to reach the Rust API (never exposed to browsers).
API_URL=http://127.0.0.1:8088
# Address shown to developers in API examples.
PUBLIC_API_URL=http://127.0.0.1:8088
API_CONNECT_TIMEOUT=5
API_TIMEOUT=40
API_VERIFY_TLS=true

PRODUCT_NAME=Mailvora
SUPPORT_EMAIL=support@mailvora.local
COMPANY_NAME=Mailvora
COMPANY_ADDRESS=
COMPANY_COUNTRY=Kenya
SIGNUP_ENABLED=true
# Opaque session-bound addresses for signed-in pages (always on in production).
SEALED_LINKS=true
# Same as the API's SPF_INCLUDE; offered in the DNS record generator.
SPF_INCLUDE=

SESSION_NAME=mv_session
SESSION_SECURE=false
SESSION_IDLE_MINUTES=120
TRUST_PROXY=false
# STORAGE_PATH defaults to ./storage (sessions + logs; must be writable).

# Optional: sign Apple .mobileconfig profiles so iOS shows them as "Verified".
# Use a certificate issued for your domain (e.g. the web TLS cert + chain).
APPLE_PROFILE_SIGNING_CERT=
APPLE_PROFILE_SIGNING_KEY=
APPLE_PROFILE_SIGNING_CHAIN=
APPLE_PROFILE_SIGNING_KEY_PASSPHRASE=
