{
    "name": "mailvora/frontend",
    "description": "Mailvora web application: public site, organization console, operator console, webmail and mail-app onboarding. Server-rendered PHP over the Rust platform API.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-session": "*"
    },
    "suggest": {
        "ext-openssl": "Signs Apple configuration profiles when APPLE_PROFILE_SIGNING_CERT is configured",
        "ext-opcache": "Recommended in production"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/View/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run.php",
        "serve": "php -S 127.0.0.1:8080 -t public public/router.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
